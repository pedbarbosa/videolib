<tr>
  <td class='left'><%= show %></td>
  <td><%= show_size %></td>
  <td class='center'><progress max="<%= details['episodes'] %>" value="<%= details['x265_episodes'] %>"></progress></td>
  <td><%= details['episodes'] %></td>
  <td><%= episode_badge(details) %></td>
<% FORMAT_COLUMNS.each_key do |column| %>
  <td><%= details[column] %></td>
<% end %>
</tr>
